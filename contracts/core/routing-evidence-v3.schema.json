{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routing-evidence-v3.schema.json",
  "title": "Routing Policy V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_sha256", "policy_id", "source_set_sha256", "assertions", "allowed_sensitivities", "policy_owner_identity", "verifier_identity"],
  "properties": {
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "policy_id": {"type": "string", "minLength": 1},
    "source_set_sha256": {"$ref": "#/$defs/sha256"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "allowed_sensitivities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["public", "internal", "restricted"]}
    },
    "policy_owner_identity": {"type": "string", "minLength": 1},
    "verifier_identity": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "source_path", "source_sha256", "byte_start", "byte_end", "excerpt_sha256", "kind", "value", "trust", "freshness", "sensitivity", "admission", "eligible", "agent_generated", "verifier_promoted", "promotion_record_sha256", "promotion_verifier_identity"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["scope", "operation", "fact"]},
        "value": {"type": "string", "minLength": 1},
        "trust": {"enum": ["verified_source", "policy_admitted", "agent_generated", "quarantined", "unverifiable"]},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "sensitivity": {"enum": ["public", "internal", "restricted"]},
        "admission": {"enum": ["none", "policy", "verifier"]},
        "eligible": {"type": "boolean"},
        "agent_generated": {"type": "boolean"},
        "verifier_promoted": {"type": "boolean"},
        "promotion_record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "promotion_verifier_identity": {"type": ["string", "null"]}
      }
    }
  }
}
