{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "routing-authority-v3.schema.json",
  "title": "Routing Authority Anchor V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor_sha256",
    "authority_id",
    "candidate_sha256",
    "policy_sha256",
    "source_snapshot_sha256",
    "invocation_binding_sha256",
    "verifier_identity",
    "admission_receipt_sha256",
    "authority_context_sha256"
  ],
  "properties": {
    "anchor_sha256": {"$ref": "#/$defs/sha256"},
    "authority_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "invocation_binding_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_identity": {"type": "string", "minLength": 1},
    "admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "authority_context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
