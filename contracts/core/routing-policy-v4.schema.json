{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velcrafting.dev/contracts/core/routing-policy-v4.schema.json",
  "$comment": "Runtime PortableTextV4 and PortablePathV4 validation is mandatory before deserialization or recommendation. This schema does not claim lexical admission.",
  "title": "Advisory routing policy V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "source_set_sha256", "assertions", "policy_sha256"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "source_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "source_path", "source_sha256", "byte_start", "byte_end", "excerpt_sha256", "kind", "value", "status"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 1},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"enum": ["scope", "operation", "structural_fact"]},
        "value": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "stale", "unknown", "ineligible"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "scope"}}}, "then": {"properties": {"value": {"enum": ["project", "federation", "unknown"]}}}},
        {"if": {"properties": {"kind": {"const": "operation"}}}, "then": {"properties": {"value": {"enum": ["assess", "design", "initialize", "validate", "evaluate", "repair", "evolve", "inspect", "plan", "verify", "admit", "reconcile", "impact", "retire"]}}}},
        {"if": {"properties": {"kind": {"const": "structural_fact"}}}, "then": {"properties": {"value": {"enum": ["project_scope", "federation_scope", "structural_need", "graph_worthy", "direct_baseline_sufficient", "registry_reference", "cross_project_action"]}}}}
      ]
    }
  }
}
