{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velcrafting.dev/contracts/core/routing-snapshot-v4.schema.json",
  "$comment": "Runtime PortableTextV4 and PortablePathV4 validation is mandatory before deserialization or recommendation. This schema does not claim lexical admission.",
  "title": "Advisory routing source snapshot V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_sha256", "sources"],
  "properties": {
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
